   "source": [
    "# DNA → Protein BLAST Pipeline\n",
    "This notebook runs BLASTn and BLASTp, translates DNA to protein, and shows top hits."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "from Bio.Blast import NCBIWWW, NCBIXML\n",
    "from Bio.Seq import Seq"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "def run_blastn(dna_seq, top_hits=5):\n",
    "    print(\"Running BLASTn...\")\n",
    "    result_handle = NCBIWWW.qblast(\"blastn\", \"nt\", dna_seq)\n",
    "    blast_records = NCBIXML.parse(result_handle)\n",
    "    blast_record = next(blast_records)\n",
    "    hits = []\n",
    "    for alignment in blast_record.alignments[:top_hits]:\n",
    "        hsp = alignment.hsps[0]\n",
    "        hits.append({\n",
    "            \"title\": alignment.title,\n",
    "            \"length\": alignment.length,\n",
    "            \"score\": hsp.score,\n",
    "            \"e_value\": hsp.expect,\n",
    "            \"percent_identity\": (hsp.identities / hsp.align_length) * 100\n",
    "        })\n",
    "    return hits"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "def translate_dna(dna_seq):\n",
    "    dna = Seq(dna_seq)\n",
    "    return dna.translate()"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "def run_blastp(protein_seq, top_hits=5):\n",
    "    print(\"Running BLASTp...\")\n",
    "    result_handle = NCBIWWW.qblast(\"blastp\", \"nr\", protein_seq)\n",
    "    blast_records = NCBIXML.parse(result_handle)\n",
    "    blast_record = next(blast_records)\n",
    "    hits = []\n",
    "    for alignment in blast_record.alignments[:top_hits]:\n",
    "        hsp = alignment.hsps[0]\n",
    "        hits.append({\n",
    "            \"title\": alignment.title,\n",
    "            \"length\": alignment.length,\n",
    "            \"score\": hsp.score,\n",
    "            \"e_value\": hsp.expect,\n",
    "            \"percent_identity\": (hsp.identities / hsp.align_length) * 100\n",
    "        })\n",
    "    return hits"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "def print_hits(hits, search_type=\"BLAST\"):\n",
    "    print(f\"\\nTop {len(hits)} hits from {search_type}:\")\n",
    "    for i, hit in enumerate(hits, 1):\n",
    "        print(f\"{i}. {hit['title']}\")\n",
    "        print(f\"   Length: {hit['length']}  Score: {hit['score']}  E-value: {hit['e_value']:.2e}  Percent identity: {hit['percent_identity']:.2f}%\\n\")"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# Input DNA sequence\n",
    "dna_input = input(\"Enter your DNA sequence: \").strip().upper()\n",
    "\n",
    "# Run BLASTn\n",
    "blastn_hits = run_blastn(dna_input)\n",
    "print_hits(blastn_hits, \"BLASTn\")\n",
    "\n",
    "# Translate DNA → Protein\n",
    "protein_seq = translate_dna(dna_input)\n",
    "print(f\"Translated Protein Sequence:\\n{protein_seq}\\n\")\n",
    "\n",
    "# Run BLASTp\n",
    "blastp_hits = run_blastp(protein_seq)\n",
    "print_hits(blastp_hits, \"BLASTp\")"
   ]
  }
